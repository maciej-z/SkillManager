---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import StartAssessmentButton from "@/components/assessment/StartAssessmentButton";
import AssessmentForm from "@/components/assessment/AssessmentForm";
import type { Assessment, AssessmentScore, Competency, CompetencyModel } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let activeModel: CompetencyModel | null = null;
let competencies: Competency[] = [];
let assessment: Assessment | null = null;
let scores: AssessmentScore[] = [];
let loadError: string | null = null;

if (supabase && user) {
  const { data: modelData, error: modelError } = await supabase
    .from("competency_models")
    .select("*")
    .eq("is_active", true)
    .maybeSingle<CompetencyModel>();
  if (modelError) {
    loadError = modelError.message;
  }
  activeModel = modelData;

  if (activeModel) {
    const { data: competencyData, error: competencyError } = await supabase
      .from("competencies")
      .select("*")
      .eq("competency_model_id", activeModel.id)
      .order("name")
      .overrideTypes<Competency[], { merge: false }>();
    if (competencyError) {
      loadError = loadError ?? competencyError.message;
    }
    competencies = competencyData ?? [];

    const { data: assessmentData, error: assessmentError } = await supabase
      .from("assessments")
      .select("*")
      .eq("employee_id", user.id)
      .eq("competency_model_id", activeModel.id)
      .maybeSingle<Assessment>();
    if (assessmentError) {
      loadError = loadError ?? assessmentError.message;
    }
    assessment = assessmentData;

    if (assessment) {
      const { data: scoreData, error: scoreError } = await supabase
        .from("assessment_scores")
        .select("*")
        .eq("assessment_id", assessment.id)
        .overrideTypes<AssessmentScore[], { merge: false }>();
      if (scoreError) {
        loadError = loadError ?? scoreError.message;
      }
      scores = scoreData ?? [];
    }
  }
}

const scoresByCompetencyId = new Map(scores.map((s) => [s.competency_id, s]));
---

<Layout title="Self-Assessment">
  <div class="mx-auto max-w-3xl p-8">
    <a href="/dashboard" class="text-sm text-blue-600 hover:underline">&larr; Dashboard</a>
    <h1 class="my-4 text-2xl font-bold">Self-Assessment</h1>
    {loadError && <p class="mb-4 text-sm text-red-600">Failed to load assessment: {loadError}</p>}

    {
      !activeModel && !loadError && (
        <p class="text-muted-foreground">No competency model is active yet — check back later.</p>
      )
    }

    {
      activeModel && !assessment && (
        <div>
          <p class="text-muted-foreground mb-4">
            Start your self-assessment against the current competency model ({competencies.length} competencies).
          </p>
          <StartAssessmentButton client:load />
        </div>
      )
    }

    {
      activeModel && assessment?.status === "draft" && (
        <AssessmentForm client:load assessmentId={assessment.id} competencies={competencies} existingScores={scores} />
      )
    }

    {
      activeModel && assessment?.status === "submitted" && (
        <div class="flex flex-col gap-4">
          <p class="text-muted-foreground text-sm">
            Submitted {assessment.submitted_at && new Date(assessment.submitted_at).toLocaleString()} — this assessment
            is locked and can no longer be edited.
          </p>
          {competencies.map((competency) => (
            <div class="rounded-lg border p-4">
              <div class="mb-1 font-medium">{competency.name}</div>
              <div class="text-sm">Score: {scoresByCompetencyId.get(competency.id)?.score ?? "—"}</div>
              {scoresByCompetencyId.get(competency.id)?.comment && (
                <p class="text-muted-foreground mt-1 text-sm">{scoresByCompetencyId.get(competency.id)?.comment}</p>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</Layout>
